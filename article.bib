	year = {2022},
	doi = {10.1007/978-3-030-90903-1_4},
	pages = {61--88},
	file = {Full Text PDF:C\:\\Users\\yisus\\Zotero\\storage\\I6GMKTH3\\Velasco-Montero et al. - 2022 - Relevant Hardware Metrics for Performance Evaluation.pdf:application/pdf},
