@incollection{velasco-montero_optimal_2022,
	address = {Cham},
	title = {Optimal {Selection} of {Software} and {Models} for {Visual} {Inference}},
	isbn = {978-3-030-90903-1},
	url = {https://doi.org/10.1007/978-3-030-90903-1_3},
	abstract = {The vast technological ecosystem of components for visual inference on edge devices makes it difficult to determine the best option according to the target application specifications. For instance, power consumption is crucial for edge smart cameras, whereas real-time processing may be a requisite for other applications. This chapter describes two graphical methodologies to select the optimum combination of convolutional neural network and software framework for boosting visual performance on embedded systems. Three indicators of inference performance—accuracy, throughput, and power consumption—will represent the decision variables for optimization. Both single-objective and multi-objective problems regarding those metrics are introduced in this chapter. Prior to conducting optimization, real values of inference performance must be obtained by benchmarking a diversity of components. In particular, the proposed methodologies are illustrated through a study comprising six popular network models running on four deep learning frameworks implemented on a low-cost embedded platform. Practical tips for integrating those components are also accompanied. In the first methodology, Pareto-optimal solutions—i.e., network–framework combinations—enable pairwise metric assessment. When more than two application-level parameters come into play, we propose a second methodology based on the definition of a figure of merit that will facilitate optimal decisions. In fact, several application scenarios can be evaluated by sweeping the relative importance of performance variables. These procedures reveal that only a reduced subset of network–software pairs should actually be considered for real deployment when targeting a specific embedded application.},
	language = {en},
	urldate = {2025-02-03},
	booktitle = {Visual {Inference} for {IoT} {Systems}: {A} {Practical} {Approach}},
	publisher = {Springer International Publishing},
	author = {Velasco-Montero, Delia and Fernández-Berni, Jorge and Rodríguez-Vázquez, Angel},
	editor = {Velasco-Montero, Delia and Fernández-Berni, Jorge and Rodríguez-Vázquez, Angel},
	year = {2022},
	doi = {10.1007/978-3-030-90903-1_3},
	pages = {31--60},
	file = {Full Text PDF:C\:\\Users\\yisus\\Zotero\\storage\\5C699RDK\\Velasco-Montero et al. - 2022 - Optimal Selection of Software and Models for Visual Inference.pdf:application/pdf},
}

@incollection{velasco-montero_relevant_2022,
	address = {Cham},
	title = {Relevant {Hardware} {Metrics} for {Performance} {Evaluation}},
	isbn = {978-3-030-90903-1},
	url = {https://doi.org/10.1007/978-3-030-90903-1_4},
	abstract = {This chapter presents a dual approach to assess embedded network inference performance. On the one hand, low-level hardware exploitation metrics reveal how the resources in the processor are exploited during visual inference. On the other hand, several performance parameters—throughput, power consumption, memory footprint, or CPU utilization—describe the actual system performance. More specifically, both CNN architectures—with diverse complexity and accuracy—and deep learning libraries—which adopt various coding strategies—show notable differences in terms of microarchitecture metrics when experimentally assessed. In addition, these software–hardware combinations also present a dissimilar behavior revealed by heterogeneous high-level performance metrics. Therefore, the proposed hardware-aware analysis is a powerful tool to understand software performance and find limitations and bottlenecks. In sum, a bottom-up approach for identification of correlation between measurable hardware statistics and performance figures provides insight to improve the performance of software components for network inference.},
	language = {en},
	urldate = {2025-02-03},
	booktitle = {Visual {Inference} for {IoT} {Systems}: {A} {Practical} {Approach}},
	publisher = {Springer International Publishing},
